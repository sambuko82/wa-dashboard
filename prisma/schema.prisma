generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Direction {
  IN
  OUT
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String
  role           Role            @default(USER)
  isJvto         Boolean         @default(false)
  apiKey         String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  waNumbers      WaNumber[]
  templates      Template[]
  labels         Label[]
  pipelineStages PipelineStage[]
}

model WaNumber {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String
  apiKey             String             @unique
  webhookUrl         String?
  phoneNumber        String?
  description        String?            @db.Text
  authDir            String
  authState          Json?
  connectionActiveAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  messages           MessageLog[]
  contacts           Contact[]
  notes              WaNumberNote[]
  reminders          WaNumberReminder[]
}

model WaNumberNote {
  id         String   @id @default(cuid())
  waNumberId String
  waNumber   WaNumber @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([waNumberId])
}

model WaNumberReminder {
  id          String   @id @default(cuid())
  waNumberId  String
  waNumber    WaNumber @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  description String   @db.Text
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([waNumberId])
  @@index([dueDate])
}

model MessageLog {
  id         String    @id @default(cuid())
  numberId   String
  number     WaNumber  @relation(fields: [numberId], references: [id], onDelete: Cascade)
  direction  Direction
  toFrom     String
  content    String?
  mediaType  String?
  mediaData  Json?     // url, mimetype, filename, fileSize, seconds, etc.
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([numberId])
  @@index([contactId])
  @@index([createdAt])
  @@index([toFrom])
}

model Contact {
  id              String         @id @default(cuid())
  waNumberId      String
  waNumber        WaNumber       @relation(fields: [waNumberId], references: [id], onDelete: Cascade)
  phoneNumber     String
  name            String?
  email           String?
  avatarUrl       String?
  notes           String?        @db.Text
  customFields    Json?
  labels          Label[]        @relation("ContactLabels")
  adminNotes      ContactNote[]
  messages        MessageLog[]
  pipelineStageId String?
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  reminders       Reminder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([waNumberId, phoneNumber])
  @@index([waNumberId])
  @@index([pipelineStageId])
}

model PipelineStage {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  order           Int              @default(0)
  color           String           @default("#25d366")
  contacts        Contact[]
  jvtoCrmContacts JvtoCrmContact[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

model Reminder {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  description String   @db.Text
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contactId])
  @@index([dueDate])
}

model Label {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  color           String           @default("#25d366")
  contacts        Contact[]        @relation("ContactLabels")
  jvtoCrmContacts JvtoCrmContact[] @relation("JvtoCrmContactLabels")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

model JvtoCrmContact {
  id             String             @id @default(cuid())
  jvtoCustomerId String             @unique
  pipelineStageId String?
  pipelineStage   PipelineStage?    @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  labels          Label[]           @relation("JvtoCrmContactLabels")
  notes           String?           @db.Text
  adminNotes      JvtoCrmNote[]
  reminders       JvtoCrmReminder[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([pipelineStageId])
}

model JvtoCrmNote {
  id             String         @id @default(cuid())
  crmContactId   String
  crmContact     JvtoCrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)
  content        String         @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([crmContactId])
}

model JvtoCrmReminder {
  id             String         @id @default(cuid())
  crmContactId   String
  crmContact     JvtoCrmContact @relation(fields: [crmContactId], references: [id], onDelete: Cascade)
  description    String         @db.Text
  dueDate        DateTime
  isCompleted    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([crmContactId])
  @@index([dueDate])
}

model Template {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  content       String
  description   String?
  mediaType     String?            // "image" | "file" | "video"
  mediaUrl      String?            // static URL or {variable_name}
  mediaFilename String?            // optional display name (files), can be {variable_name}
  variables     TemplateVariable[]
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  messageLogs   MessageLog[]
}

model TemplateVariable {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String   // Nama variabel seperti "user_name"
  description String? // Deskripsi variabel
  example    String?  // Contoh nilai
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JvtoReplyDraft {
  id                 String    @id @default(cuid())
  phone              String
  incomingMessage    String    @db.Text
  draft              String    @db.Text
  draftType          String
  templateId         String?
  packageSlug        String?
  confidence         Float?
  riskLevel          String    // low | medium | high
  verificationStatus String    // passed | needs_review | blocked
  checks             Json      // Record<string, boolean> — 21 keys
  failedRules        Json      // string[]
  notesForStaff      Json      // string[]
  sourceRefs         Json      // string[]
  sentAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([phone])
  @@index([createdAt])
}
